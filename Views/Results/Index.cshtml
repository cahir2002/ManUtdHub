@using ManUtdHub.ViewModels
@model ResultsViewModel;
@{
    ViewData["Title"] = "Results Page";
}

<div class="h1 text-left fw-semibold mb-4">Results</div>
<div class="row">
    <div class = "card">
        <div class = "card-header">
            <div class="row align-items-start">
                <div class="col">
                  <a asp-action="Index"
   asp-route-month="@(Model.Month == 1 ? 12 : Model.Month - 1)"
   asp-route-year="@(Model.Month == 1 ? Model.Year - 1 : Model.Year)">
    <i class="fa-solid fa-angle-left"></i>
</a>
                </div>
                <div class="col text-center fw-semibold ">
                     @Model.MonthName
                </div>
                <div class="col text-end">
                    <a asp-action="Index"
   asp-route-month="@(Model.Month == 12 ? 1 : Model.Month + 1)"
   asp-route-year="@(Model.Month == 12 ? Model.Year + 1 : Model.Year)">
    <i class="fa-solid fa-angle-right"></i>
</a>
                </div>
             </div>
    </div>
</div>
</div>
<div class="row mt-4">
    @if (!Model.Matches.Any())
    {
        <div class="card">
            <div class = "card-body">
                 <div class="col text-center fw-semibold">
            No matches found for this month.
        </div>
            </div>
        </div>
    }
    else
    {
      @foreach (var result in Model.Matches)
    {
        <div class="col-md-4">
        <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col text-center fw-semibold">
                    @result.MatchDate.ToString("d MMMM yyyy") - @result.MatchDate.ToString("h:mm tt")
                </div>
            </div>
            <div class="row mt-1">
                <div class="col text-center fw-semibold">
                    @result.Competition
                </div>
            </div>
             <div class="row mt-1">
                <div class="col text-center fw-normal">
                    @result.Stadium, @result.City
                </div>
            </div>
            <div class= "row mt-3">
                <div class="col-md-4 text-center">
                    <img src="@result.HomeTeamLogo" class="rounded logo" alt="...">
                </div>
                <div class="col-md-4 d-flex justify-content-center display-2 align-items-center fw-semibold mb-0 display-2 scoreText"> @result.HomeScore - @result.AwayScore </div>
                <div class="col-md-4 text-center">
                    <img src="@result.AwayTeamLogo" class="rounded logo" alt="...">
                </div>
            </div>
            <div class= "row mt-3">
                <div class="col-md-4 text-center
                    text-center fw-semibold">@result.HomeTeam
                </div>
                <div class="col-md-4 text-center">
                    </div>
                    
                <div class="col-md-4 text-center
                    text-center fw-semibold">@result.AwayTeam
                </div>
            </div>
        </div>
    </div>
        </div>
    }   
    }
</div>
<script>
    
</script>
